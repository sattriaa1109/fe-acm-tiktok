# Base URL backend FastAPI.
# Kosongkan (atau biarkan /api) saat dev — Vite akan proxy /api ke localhost:8000.
# Untuk build produksi yang di-serve terpisah, isi dengan URL backend, contoh:
# VITE_API_BASE_URL=http://localhost:8000
VITE_API_BASE_URL=/api

# Opsional: target proxy dev server (default http://localhost:8000)
# VITE_PROXY_TARGET=http://localhost:8000
